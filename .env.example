# Google Gemini API key (free tier works): https://aistudio.google.com/apikey
# Copy this file to .env.local and paste your key. On Vercel, add it under Project > Settings > Environment Variables.
GEMINI_API_KEY=

# Optional: override the model (defaults to gemini-3.1-flash-lite, then gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.1-flash-lite
